{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "quoteProps": "as-needed",
  "bracketSameLine": false,
  "singleAttributePerLine": true,
  "objectWrap": "collapse",
  "insertFinalNewline": true,
  "sortImports": {
    "groups": [
      ":builtin",
      ":external",
      ":internal",
      ":parent",
      ":sibling",
      ":type"
    ],
    "newlinesBetween": true,
    "order": "asc",
    "ignoreCase": false
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "bun.lock"
  ]
}
